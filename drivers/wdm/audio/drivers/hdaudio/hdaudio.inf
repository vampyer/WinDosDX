; WinDosDX High Definition Audio codec driver
;
; Installs for the audio function of any HD Audio codec on hdaudbus
; (HDAUDIO\FUNC_01, the most generic compatible ID the bus driver gives).

[Version]
Signature  = "$Windows NT$"
Class      = MEDIA
ClassGUID  = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider   = %ReactOS%
DriverVer  = 09/26/2026,1.0.0.0

[SourceDisksNames]
1 = %DiskDescription%,,,

[SourceDisksFiles]
hdaudio.sys = 1

[DestinationDirs]
HdAudio.CopyList = 12

[Manufacturer]
%MfgName% = Generic,NTx86,NTamd64

[Generic.NTx86]
%HdAudio.DeviceDesc% = HdAudio, HDAUDIO\FUNC_01

[Generic.NTamd64]
%HdAudio.DeviceDesc% = HdAudio, HDAUDIO\FUNC_01

[HdAudio.CopyList]
hdaudio.sys

[HdAudio.NT]
Include   = ks.inf,wdmaudio.inf
Needs     = KS.Registration,WDMAUDIO.Registration
CopyFiles = HdAudio.CopyList
AddReg    = HdAudio.AddReg

[HdAudio.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_Wave%,HdAudio.Interface.Wave
AddInterface = %KSCATEGORY_RENDER%,%KSNAME_Wave%,HdAudio.Interface.Wave
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_Topology%,HdAudio.Interface.Topology

[HdAudio.Interface.Wave]
AddReg = HdAudio.I.Wave.AddReg

[HdAudio.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HdAudio.Wave.Name%

[HdAudio.Interface.Topology]
AddReg = HdAudio.I.Topo.AddReg

[HdAudio.I.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%HdAudio.Topology.Name%

[HdAudio.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,hdaudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%HdAudio.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%HdAudio.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%HdAudio.DeviceDesc%

[HdAudio.NT.Services]
AddService = hdaudio, 0x00000002, HdAudio.Service

[HdAudio.Service]
DisplayName   = %HdAudio.ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\hdaudio.sys

[Strings]
ReactOS               = "WinDosDX Project"
MfgName               = "(Generic audio devices)"
DiskDescription       = "WinDosDX audio drivers"
HdAudio.DeviceDesc    = "High Definition Audio Device"
HdAudio.ServiceDesc   = "WinDosDX High Definition Audio codec driver"
HdAudio.Wave.Name     = "HD Audio Wave"
HdAudio.Topology.Name = "HD Audio Topology"
KSCATEGORY_AUDIO      = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER     = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSNAME_Wave           = "Wave"
KSNAME_Topology       = "Topology"
Proxy.CLSID           = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
